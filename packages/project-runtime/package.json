{
  "name": "@workbench/project-runtime",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "项目目录与运行时（Project Catalog）",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
