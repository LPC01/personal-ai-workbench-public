{
  "name": "@workbench/extension-sdk",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "扩展 SDK：标准模板与文档验证器",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@workbench/contracts": "workspace:*",
    "@workbench/testkit": "workspace:*"
  }
}
