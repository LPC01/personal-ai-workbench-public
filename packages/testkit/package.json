{
  "name": "@workbench/testkit",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "验证工具包：文档链接/占位符/版本一致性检查器",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  }
}
