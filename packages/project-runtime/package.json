  "dependencies": {
    "@workbench/contracts": "workspace:*",
    "@workbench/domain": "workspace:*",
    "@workbench/persistence": "workspace:*"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13"
  }
}
