{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://workbench.local/schemas/workflow.schema.json",
  "title": "workflow.v1",
  "description": "Workflow 定义契约（26 SPEC §7）",
  "type": "object",
  "required": ["schemaVersion", "id", "name", "version", "nodes"],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "const": "workflow.v1"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{2,63}$"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "nodes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/definitions/node"
      }
    }
  },
  "definitions": {
    "node": {
      "type": "object",
      "required": ["id", "type"],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "type": {
          "enum": [
            "input",
            "read-file",
            "write-artifact",
            "command",
            "model",
            "transform",
            "condition",
            "approval",
            "subworkflow",
            "output"
          ]
        },
        "inputSchema": {
          "type": "object"
        },
        "outputSchema": {
          "type": "object"
        },
        "timeoutSeconds": {
          "type": "number",
          "minimum": 0
        },
        "retry": {
          "type": "object",
          "required": ["maxAttempts"],
          "additionalProperties": false,
          "properties": {
            "maxAttempts": {
              "type": "integer",
              "minimum": 0
            }
          }
        },
        "idempotencyKey": {
          "type": "string"
        },
        "onFailure": {
          "enum": ["abort", "continue"]
        },
        "config": {
          "type": "object"
        },
        "next": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    }
  }
}
