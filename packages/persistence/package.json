{
  "name": "@workbench/persistence",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "SQLite 连接与 migration runner（WAL + foreign keys + busy timeout）",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
