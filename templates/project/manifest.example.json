{
  "schemaVersion": "workbench.project/v1",
  "project": {
    "id": "my-app",
    "name": "我的应用",
    "description": "Node 内置模块静态服务；读 PORT 环境变量；健康端点 /health"
  },
  "runtime": {
    "root": "C:/Projects/my-app",
    "port": {
      "strategy": "dynamic",
      "from": 8160,
      "to": 8169,
      "environmentVariable": "PORT"
    }
  },
  "webUI": {
    "enabled": true,
    "displayMode": "proxy",
    "startCommandId": "start",
    "healthCheck": {
      "type": "http",
      "url": "http://127.0.0.1:${port}/health",
      "timeoutSeconds": 30
    }
  },
  "commands": [
    {
      "id": "start",
      "type": "service",
      "executable": "node",
      "arguments": ["server.mjs"],
      "concurrency": "singleton"
    }
  ]
}
